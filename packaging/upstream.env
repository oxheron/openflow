# Reviewed, immutable release inputs for the native inference workers.
#
# Use a release tag rather than a moving branch. The fetch script resolves the
# tag once and records the resulting commit in the release metadata. Updating
# either value should be reviewed together with the native adapter build.
OPENFLOW_WHISPER_CPP_REPOSITORY=https://github.com/ggml-org/whisper.cpp.git
OPENFLOW_WHISPER_CPP_RELEASE=v1.9.1
OPENFLOW_WHISPER_CPP_REVISION=f049fff95a089aa9969deb009cdd4892b3e74916
OPENFLOW_LLAMA_CPP_REPOSITORY=https://github.com/ggml-org/llama.cpp.git
OPENFLOW_LLAMA_CPP_RELEASE=b10218
OPENFLOW_LLAMA_CPP_REVISION=de699957b92f490efebad149665b0dccf127eaff
