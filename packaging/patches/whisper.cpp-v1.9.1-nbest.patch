@@ -482,5 +482,26 @@ extern "C" {
                               void * user_data);
 
+    // A completed decoder hypothesis. The token pointer remains valid only for
+    // the duration of whisper_nbest_callback.
+    typedef struct whisper_nbest_hypothesis {
+        const whisper_token_data * tokens;
+        int n_tokens;
+        double sum_logprobs;
+        double avg_logprobs;
+        double score;
+        int64_t t0_ms;
+        int64_t t1_ms;
+    } whisper_nbest_hypothesis;
+
+    // Called with the unique completed hypotheses from the selected decoding
+    // temperature, ordered by decoder score with the selected result first.
+    typedef void (*whisper_nbest_callback)(
+            struct whisper_context * ctx,
+              struct whisper_state * state,
+        const whisper_nbest_hypothesis * hypotheses,
+                               int n_hypotheses,
+                              void * user_data);
+
     // Parameters for the whisper_full() function
     // If you change the order or add new parameters, make sure to update the default values in whisper.cpp:
     // whisper_full_default_params()
@@ -580,6 +598,10 @@ extern "C" {
         whisper_logits_filter_callback logits_filter_callback;
         void * logits_filter_callback_user_data;
 
+        // called after completed decoder hypotheses are ranked
+        whisper_nbest_callback nbest_callback;
+        void * nbest_callback_user_data;
+
         const whisper_grammar_element ** grammar_rules;
         size_t                           n_grammar_rules;
         size_t                           i_start_rule;
