# Keep the service on loopback when using Tailscale Serve or a local reverse proxy.
OPENFLOW_BIND=127.0.0.1:8765
OPENFLOW_MODEL_CACHE=/var/lib/openflow/models
OPENFLOW_AUTH_STORE=/var/lib/openflow/auth.json
OPENFLOW_WORKER_BACKEND=auto

# Containerized GPU hosts can make runtime discovery explicit. Prefer normal
# /dev/kfd discovery on a native ROCm host; set the byte limit if DRM sysfs is
# not visible inside the container.
# OPENFLOW_ROCM_AVAILABLE=1
# OPENFLOW_ACCELERATOR_MEMORY_BYTES=8589934592

# For a direct remote listener, uncomment all three settings and use a firewall.
# OPENFLOW_BIND=0.0.0.0:8765
# OPENFLOW_TLS_CERT=/etc/openflow/server.crt
# OPENFLOW_TLS_KEY=/etc/openflow/server.key

# Optional: set a stable administrator token of at least 24 URL-safe characters.
# If omitted, the server prints a one-time bootstrap envelope on first start.
# OPENFLOW_ADMIN_TOKEN=replace-with-a-secret-from-a-password-manager
